    "jsCode": "const ag = $('Agente').first().json || {};\nconst e = $('Entrada').first().json;\nconst steps = (Array.isArray(ag.intermediateSteps) ? ag.intermediateSteps : []).map((s) => ({ tool: s && s.action && s.action.tool, input: s && s.action && s.action.toolInput, obs: String((s && s.observation) || '').slice(0, 400) }));\nconst texto = typeof ag.output === 'string' ? ag.output.trim() : '';\nreturn [{ json: { respuesta: texto || 'No pude resolver esto en este momento: avisá a la clínica con avisar_grupo si hace falta.', traza: JSON.stringify(steps), lista: 'traza:' + e.tel + ':' + e.exec_id_actual } }];"
